generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campaign {
  id           String   @id @default(cuid())
  postcode     String
  min_price    Decimal  @db.Decimal(12, 2)
  agent_name   String
  agent_phone  String
  agent_email  String
  status       String   @default("pending")
  /// Fine-grained pipeline stage while status is running
  stage        String?
  created_at   DateTime @default(now())
  parcels      Parcel[]

  @@map("Campaign")
}

model Parcel {
  id             String    @id @default(cuid())
  campaign_id    String
  department     String
  municipality   String
  section        String
  parcel_number  String
  sale_price     Decimal?  @db.Decimal(12, 2)
  sale_date      DateTime?
  address        String?
  house_area     Decimal?  @db.Decimal(10, 2)
  plot_area      Decimal?  @db.Decimal(10, 2)
  grade          String?
  reason         String?
  analysis       String?
  campaign       Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("Parcels")
}
